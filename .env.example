PORT=3000
# 127.0.0.1 = accès uniquement depuis ce poste ; 0.0.0.0 = accessible sur le réseau local
HOST=0.0.0.0
NODE_ENV=production
# Secret de signature des sessions : générez-en un long et aléatoire (ex. : openssl rand -hex 48)
JWT_SECRET=REMPLACER_PAR_UN_SECRET_LONG_ALEATOIRE
DB_FILE=./database/comptabilite.sqlite
# Nombre de sauvegardes automatiques quotidiennes conservées
BACKUP_KEEP=30
# Derrière un reverse proxy (Coolify, Traefik, Nginx) : 1 = faire confiance à 1 proxy (nécessaire pour le limiteur de connexion)
TRUST_PROXY=1
# Clé de chiffrement des secrets 2FA (facultatif ; par défaut dérivée de JWT_SECRET). Ne jamais la changer après activation de la 2FA.
# TOTP_KEY=
